# Created by https://www.gitignore.io/api/vim
# Edit at https://www.gitignore.io/?templates=vim

### Vim ###
# Swap
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Session
Session.vim
Sessionx.vim

# Temporary
.netrwhist
*~
# Auto-generated tag files
tags
# Persistent undo
[._]*.un~

### Python ###
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# ignore gpg private keys
kpri.*.asc

# used when running in development
devrun*/
logs/

# build output - regenerated by the build, must not be versioned.
# It was previously tracked, which made Dependabot report every dependency
# alert twice: once for pom.xml, once for the stale copy under
# target/classes/META-INF/maven/.
target/
